# Database Configuration (Docker PostGIS)
POSTGRES_USER=spatial_user
POSTGRES_PASSWORD=spatial_password_change_me
POSTGRES_DB=spatial_twin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Static Assets Path
STATIC_ASSETS_DIR=./static

# Local offline reconstruction workspace and verified toolchain
PIPELINE_WORKSPACE=./output/reconstruction_jobs
PIPELINE_MAX_INPUT_BYTES=4294967296
PIPELINE_STAGE_TIMEOUT_SECONDS=21600
# Optional absolute path to the project-local COLMAP executable. Empty = auto-discover/PATH.
COLMAP_EXECUTABLE=

# Kaggle Cloud GPU Automation (Optional; not used by local-only Phase A)
# Cloud uploads are disabled by the approved offline policy.
KAGGLE_USERNAME=
KAGGLE_KEY=
